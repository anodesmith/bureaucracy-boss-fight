# ---------------------------------------------------------------------------
# Bureaucracy Boss Fight - provider configuration
#
# The game ALWAYS runs with zero configuration (DEMO MODE).
# Every variable below is optional. Demo Mode uses a deterministic, scripted
# Game Master so a fresh clone is instantly playable.
# ---------------------------------------------------------------------------

# Which provider to use: demo | openai | ollama
#   demo   -> deterministic scripted responses, no network, no API key
#   openai -> any OpenAI-compatible /chat/completions endpoint
#             (OpenAI, OpenRouter, Groq, Together, LM Studio, vLLM, ...)
#   ollama -> local Ollama server
PROVIDER=demo

# --- OpenAI-compatible -----------------------------------------------------
# API key. For OpenRouter use your OpenRouter key here.
API_KEY=

# Base URL. Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://localhost:1234/v1        (LM Studio)
#   http://localhost:8000/v1        (vLLM)
BASE_URL=https://api.openai.com/v1

MODEL=gpt-4o-mini

# Optional. Sent to OpenRouter; harmless for OpenAI-compatible servers.
APP_REFERENCE=bureaucracy-boss-fight
APP_TITLE=Bureaucracy Boss Fight

# --- Ollama ----------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Generation ------------------------------------------------------------
# 0.0 is fully deterministic. The engine itself is ALWAYS deterministic
# regardless of these values; this only affects prose variation.
TEMPERATURE=0.2

# --- Server ----------------------------------------------------------------
PORT=3000

# --- Evaluation ------------------------------------------------------------
# Hard ceiling on turns spent in live LLM calls during a single player action.
LLM_TIMEOUT_MS=45000
