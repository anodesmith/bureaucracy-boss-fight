{
  "name": "bureaucracy-boss-fight",
  "version": "0.1.0",
  "private": true,
  "description": "Bureaucracy Boss Fight - an evidence-grounded agentic game about Kenyan real-world bureaucracy.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "tsx src/server/main.ts",
    "dev": "tsx watch src/server/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "eval": "tsx src/eval/cli.ts",
    "eval:matrix": "tsx src/eval/cli.ts --matrix",
    "kb:check": "tsx src/eval/kb_check.ts"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
